import socket
import cv2
import time
import threading
import struct
import csv
import numpy as np
from datetime import datetime

# ─────────────────────────────────────────────
#  CONFIGURATION — must match TCP config for fair comparison
# ─────────────────────────────────────────────
JETSON_IP      = "192.168.0.102"
JETSON_PORT    = 5005
PC_PORT        = 5006

SEND_FPS       = 30          # same as TCP
JPEG_QUALITY   = 85          # same as TCP — larger frames
FRAME_WIDTH    = 640         # same as TCP
FRAME_HEIGHT   = 480
MAX_FRAMES     = 500

# Burst injection: same parameters as TCP so comparison is fair
BURST_EVERY    = 50
BURST_COUNT    = 5

# UDP MTU safety: standard UDP payload limit is ~65507 bytes.
# At 640x480 JPEG quality=85, frames are ~20-35KB — safe.
# If you push quality to 95+ at 1280x720, you may need to chunk.
MAX_UDP_SIZE   = 65000       # hard limit; frames above this are skipped

# ─────────────────────────────────────────────

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind(("", PC_PORT))

cap = cv2.VideoCapture(0)
if not cap.isOpened():
    USE_SYNTHETIC = True
    print("[INFO] No webcam found, using synthetic frames")
else:
    USE_SYNTHETIC = False

CSV_COLUMNS = [
    "protocol", "frame", "pc_send_time", "jetson_recv_time",
    "jetson_done_time", "pc_feedback_time", "inference_ms",
    "round_trip_ms", "jitter_ms", "jpeg_bytes", "is_burst"
]

results         = []
results_lock    = threading.Lock()
send_times      = {}
send_times_lock = threading.Lock()
received_seqs   = set()
recv_count      = 0
prev_rtt        = None
jitters         = []
burst_frames    = set()
sender_done     = threading.Event()


# ─────────────────────────────────────────────
#  UTIL
# ─────────────────────────────────────────────
def make_frame(seq):
    if USE_SYNTHETIC:
        img = np.zeros((FRAME_HEIGHT, FRAME_WIDTH, 3), dtype=np.uint8)
        img[:, :, 1] = np.linspace(0, 255, FRAME_WIDTH, dtype=np.uint8)
        img[:, :, 0] = (seq * 5) % 256
        cv2.putText(img, f"UDP Frame {seq}", (20, 240),
                    cv2.FONT_HERSHEY_SIMPLEX, 1.5, (255, 255, 255), 2)
        return img
    else:
        ret, frame = cap.read()
        if not ret:
            return None
        return cv2.resize(frame, (FRAME_WIDTH, FRAME_HEIGHT))


# ─────────────────────────────────────────────
#  SAVE + SUMMARY
# ─────────────────────────────────────────────
def save_csv():
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename  = f"udp_results_frame_drp.csv"   # fixed name for analysis scripts

    with open(filename, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=CSV_COLUMNS)
        writer.writeheader()
        writer.writerows(results)

    expected   = set(range(MAX_FRAMES))
    missing    = expected - received_seqs
    dropped    = len(missing)
    drop_rate  = (dropped / MAX_FRAMES) * 100

    burst_rtts   = [r["round_trip_ms"] for r in results if r["is_burst"]]
    normal_rtts  = [r["round_trip_ms"] for r in results if not r["is_burst"]]
    all_rtts     = [r["round_trip_ms"] for r in results]

    avg_jitter = float(np.mean(jitters)) if jitters else 0
    max_jitter = float(np.max(jitters)) if jitters else 0

    print("\n╔══════════════════════════════╗")
    print("║     UDP TEST SUMMARY          ║")
    print("╠══════════════════════════════╣")
    print(f"║ Sent             : {MAX_FRAMES}")
    print(f"║ Received         : {len(received_seqs)}")
    print(f"║ Dropped          : {dropped}  ({drop_rate:.2f}%)")
    print(f"║ FPS              : {SEND_FPS}")
    print(f"║ JPEG quality     : {JPEG_QUALITY}")
    print(f"║ Frame size       : {FRAME_WIDTH}x{FRAME_HEIGHT}")
    print("╠══════════════════════════════╣")
    if all_rtts:
        print(f"║ RTT mean         : {np.mean(all_rtts):.2f} ms")
        print(f"║ RTT median       : {np.median(all_rtts):.2f} ms")
        print(f"║ RTT min          : {np.min(all_rtts):.2f} ms")
        print(f"║ RTT max          : {np.max(all_rtts):.2f} ms")
        print(f"║ RTT stdev        : {np.std(all_rtts):.2f} ms")
    if burst_rtts:
        print(f"║ Burst RTT mean   : {np.mean(burst_rtts):.2f} ms")
    if normal_rtts:
        print(f"║ Normal RTT mean  : {np.mean(normal_rtts):.2f} ms")
    print(f"║ Avg jitter       : {avg_jitter:.2f} ms")
    print(f"║ Max jitter       : {max_jitter:.2f} ms")
    print("╚══════════════════════════════╝")
    print(f"[SAVED] {len(results)} rows → {filename}")


# ─────────────────────────────────────────────
#  RECEIVER THREAD
# ─────────────────────────────────────────────
def receive_feedback():
    global recv_count, prev_rtt

    # struct: seq(I), jetson_recv(d), jetson_done(d), inference_ms(d)
    fb_size = struct.calcsize("Iddd")

    while True:
        try:
            data, _ = sock.recvfrom(1024)
        except OSError:
            break

        if len(data) < fb_size:
            continue

        pc_feedback_time = time.time()
        seq_recv, jetson_recv_time, jetson_done_time, inference_ms = \
            struct.unpack("Iddd", data[:fb_size])

        with send_times_lock:
            entry = send_times.get(seq_recv, None)
        if entry is None:
            continue

        pc_send_time, jpeg_bytes = entry

        if seq_recv in received_seqs:
            continue
        received_seqs.add(seq_recv)
        recv_count += 1

        rtt = (pc_feedback_time - pc_send_time) * 1000

        if prev_rtt is not None:
            jitter = abs(rtt - prev_rtt)
            jitters.append(jitter)
        else:
            jitter = 0
        prev_rtt = rtt

        row = {
            "protocol":         "udp",
            "frame":            seq_recv,
            "pc_send_time":     pc_send_time,
            "jetson_recv_time": jetson_recv_time,
            "jetson_done_time": jetson_done_time,
            "pc_feedback_time": pc_feedback_time,
            "inference_ms":     round(inference_ms, 3),
            "round_trip_ms":    round(rtt, 3),
            "jitter_ms":        round(jitter, 3),
            "jpeg_bytes":       jpeg_bytes,
            "is_burst":         seq_recv in burst_frames,
        }

        with results_lock:
            results.append(row)

        print(f"[UDP] seq={seq_recv:04d}  rtt={rtt:7.2f}ms  "
              f"jitter={jitter:6.2f}ms  inf={inference_ms:.2f}ms"
              + ("  ← BURST" if seq_recv in burst_frames else ""))

        # Stop receiving only after sender is done AND we've waited
        # (UDP may still have late arrivals — handled by timeout below)


# ─────────────────────────────────────────────
#  SENDER
# ─────────────────────────────────────────────
def send_frames():
    for seq in range(MAX_FRAMES):
        loop_start = time.time()

        img = make_frame(seq)
        if img is None:
            continue

        _, jpg = cv2.imencode('.jpg', img,
                              [int(cv2.IMWRITE_JPEG_QUALITY), JPEG_QUALITY])
        data = jpg.tobytes()

        if len(data) > MAX_UDP_SIZE:
            print(f"[WARN] Frame {seq} too large ({len(data)} bytes), skipping")
            continue

        send_time = time.time()
        header    = struct.pack("Id", seq, send_time)
        packet    = header + data

        sock.sendto(packet, (JETSON_IP, JETSON_PORT))

        with send_times_lock:
            send_times[seq] = (send_time, len(data))

        # ── Burst injection ──────────────────────────────────────
        # UDP will DROP some of these under any congestion because there
        # is no flow control — the Jetson receive buffer fills up.
        # TCP would QUEUE them, causing RTT spikes instead of drops.
        if seq > 0 and seq % BURST_EVERY == 0:
            for b in range(BURST_COUNT):
                bseq = (seq * 100 + b) % MAX_FRAMES  # map to valid range
                bimg = make_frame(bseq)
                if bimg is None:
                    continue
                _, bjpg = cv2.imencode('.jpg', bimg,
                                       [int(cv2.IMWRITE_JPEG_QUALITY), JPEG_QUALITY])
                bdata = bjpg.tobytes()
                if len(bdata) > MAX_UDP_SIZE:
                    continue
                bsend_time = time.time()
                bheader    = struct.pack("Id", bseq, bsend_time)
                sock.sendto(bheader + bdata, (JETSON_IP, JETSON_PORT))
                burst_frames.add(bseq)
                with send_times_lock:
                    if bseq not in send_times:
                        send_times[bseq] = (bsend_time, len(bdata))

        # ── Pacing sleep ─────────────────────────────────────────
        elapsed   = time.time() - loop_start
        sleep_for = max(0.0, (1.0 / SEND_FPS) - elapsed)
        time.sleep(sleep_for)

    print(f"[DONE] Sent {MAX_FRAMES} frames. Waiting 5s for late UDP feedback...")
    time.sleep(5)   # UDP packets can arrive late — give them time
    sender_done.set()


# ─────────────────────────────────────────────
#  RUN
# ─────────────────────────────────────────────
threading.Thread(target=receive_feedback, daemon=True).start()
send_frames()

sender_done.wait()
save_csv()

if not USE_SYNTHETIC:
    cap.release()
sock.close()
