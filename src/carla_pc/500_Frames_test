import socket
import cv2
import time
import threading
import struct
import csv
import numpy as np
from datetime import datetime
import queue

JETSON_IP       = "192.168.0.102"
JETSON_PORT     = 6000

SEND_FPS        = 30
JPEG_QUALITY    = 85
FRAME_WIDTH     = 640
FRAME_HEIGHT    = 480
MAX_FRAMES      = 500         # total frames to ATTEMPT to send

# ── Application-layer drop controls ──────────────────────────────────
# These are the ONLY levers that create legitimate TCP frame drops.

QUEUE_MAXSIZE   = 3           # max frames waiting in send queue
                              # when full, new frames are dropped (not sent)
                              # → mimics a real-time pipeline that can't buffer indefinitely

MAX_FRAME_AGE_S = 0.08        # 80 ms max age: if a frame has been waiting
                              # in the queue longer than this, discard it
                              # → mimics stale-frame discard (common in AV systems)

# Non-blocking socket send: if TCP send buffer is full, skip the frame
# rather than blocking. Set True for realistic real-time behaviour.
SKIP_ON_BLOCK   = True

TCP_NODELAY     = True        # disable Nagle algorithm

# ─────────────────────────────────────────────────────────────────────

sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
if TCP_NODELAY:
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
if SKIP_ON_BLOCK:
    sock.setblocking(False)
sock.connect((JETSON_IP, JETSON_PORT)) if not SKIP_ON_BLOCK else None

# For non-blocking connect we need a small workaround
if SKIP_ON_BLOCK:
    # reset to blocking just for the connect, then back to non-blocking
    sock.setblocking(True)
    sock.connect((JETSON_IP, JETSON_PORT))
    sock.setblocking(False)

cap = cv2.VideoCapture(0)
if not cap.isOpened():
    USE_SYNTHETIC = True
    print("[INFO] No webcam — using synthetic frames")
else:
    USE_SYNTHETIC = False

CSV_COLUMNS = [
    "protocol", "frame", "pc_send_time", "jetson_recv_time",
    "jetson_done_time", "pc_feedback_time", "inference_ms",
    "round_trip_ms", "jitter_ms", "jpeg_bytes",
    "drop_reason"    # NEW: why was this frame dropped (if it was)
]

results           = []
results_lock      = threading.Lock()
send_times        = {}
send_times_lock   = threading.Lock()
received_seqs     = set()
recv_count        = 0
prev_rtt          = None
jitters           = []
recv_done_event   = threading.Event()

# Drop tracking
dropped_queue_full   = 0    # dropped because send queue was full
dropped_stale        = 0    # dropped because frame was too old
dropped_socket_block = 0    # dropped because TCP send buffer was full
frames_actually_sent = 0    # frames that made it onto the wire

# The send queue holds (seq, encoded_bytes, capture_time) tuples
send_queue = queue.Queue(maxsize=QUEUE_MAXSIZE)


def make_frame(seq):
    if USE_SYNTHETIC:
        img = np.zeros((FRAME_HEIGHT, FRAME_WIDTH, 3), dtype=np.uint8)
        img[:, :, 0] = np.linspace(0, 200, FRAME_WIDTH, dtype=np.uint8)
        img[:, :, 2] = (seq * 3) % 200
        cv2.putText(img, f"TCP Frame {seq}", (20, 240),
                    cv2.FONT_HERSHEY_SIMPLEX, 1.4, (255, 255, 255), 2)
        return img
    else:
        ret, frame = cap.read()
        if not ret:
            return None
        return cv2.resize(frame, (FRAME_WIDTH, FRAME_HEIGHT))


# ─────────────────────────────────────────────────────────────────────
#  SAVE + SUMMARY
# ─────────────────────────────────────────────────────────────────────
def save_csv():
    filename = "tcp_results_frame_drp.csv"
    with open(filename, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=CSV_COLUMNS)
        writer.writeheader()
        writer.writerows(results)

    total_dropped = dropped_queue_full + dropped_stale + dropped_socket_block
    drop_rate     = (total_dropped / MAX_FRAMES) * 100

    all_rtts = [r["round_trip_ms"] for r in results]

    print("\n╔══════════════════════════════════════╗")
    print("║    TCP TEST SUMMARY   ║")
    print("╠══════════════════════════════════════╣")
    print(f"║ Frames attempted      : {MAX_FRAMES}")
    print(f"║ Frames sent  : {frames_actually_sent}")
    print(f"║ Frames received (Jetson feedback) : {len(received_seqs)}")
    print(f"║")
    print(f"║ Total drops       : {total_dropped}  ({drop_rate:.1f}%)")
    print(f"║   Queue full drops    : {dropped_queue_full}")
    print(f"║   Stale frame drops   : {dropped_stale}")
    print(f"║   Socket block drops  : {dropped_socket_block}")
    print(f"║")
    print(f"╠══════════════════════════════════════╣")
    if all_rtts:
        print(f"║ RTT mean    : {np.mean(all_rtts):.2f} ms")
        print(f"║ RTT median  : {np.median(all_rtts):.2f} ms")
        print(f"║ RTT min     : {np.min(all_rtts):.2f} ms")
        print(f"║ RTT max     : {np.max(all_rtts):.2f} ms")
    print(f"║ Avg jitter  : {np.mean(jitters):.2f} ms" if jitters else "║ Avg jitter  : N/A")
    print("╚══════════════════════════════════════╝")
    print(f"[SAVED] {len(results)} rows → {filename}")


# ─────────────────────────────────────────────────────────────────────
#  RECEIVER THREAD
# ─────────────────────────────────────────────────────────────────────
def receiver_thread():
    global recv_count, prev_rtt
    # switch socket back to blocking for reads
    sock.setblocking(True)
    fb_size = struct.calcsize("Iddd")

    buf = b''
    while True:
        try:
            chunk = sock.recv(4096)
        except Exception:
            break
        if not chunk:
            break
        buf += chunk
        while len(buf) >= fb_size:
            fb = buf[:fb_size]
            buf = buf[fb_size:]

            pc_feedback_time = time.time()
            seq_recv, jetson_recv_time, jetson_done_time, inference_ms = \
                struct.unpack("Iddd", fb)

            with send_times_lock:
                entry = send_times.get(seq_recv, None)
            if entry is None:
                continue

            pc_send_time, jpeg_bytes = entry

            if seq_recv in received_seqs:
                continue
            received_seqs.add(seq_recv)
            recv_count += 1

            rtt = (pc_feedback_time - pc_send_time) * 1000

            if prev_rtt is not None:
                jitter = abs(rtt - prev_rtt)
                jitters.append(jitter)
            else:
                jitter = 0
            prev_rtt = rtt

            row = {
                "protocol":         "tcp",
                "frame":            seq_recv,
                "pc_send_time":     pc_send_time,
                "jetson_recv_time": jetson_recv_time,
                "jetson_done_time": jetson_done_time,
                "pc_feedback_time": pc_feedback_time,
                "inference_ms":     round(inference_ms, 3),
                "round_trip_ms":    round(rtt, 3),
                "jitter_ms":        round(jitter, 3),
                "jpeg_bytes":       jpeg_bytes,
                "drop_reason":      "none",
            }

            with results_lock:
                results.append(row)

            print(f"[TCP] seq={seq_recv:04d}  rtt={rtt:7.2f}ms  "
                  f"jitter={jitter:6.2f}ms  inf={inference_ms:.2f}ms")

            if len(received_seqs) >= MAX_FRAMES:
                break

    recv_done_event.set()


# ─────────────────────────────────────────────────────────────────────
#  SENDER WORKER — reads from queue, applies stale check, sends
# ─────────────────────────────────────────────────────────────────────
def sender_worker():
    global dropped_stale, dropped_socket_block, frames_actually_sent

    while True:
        try:
            item = send_queue.get(timeout=3.0)
        except queue.Empty:
            break

        if item is None:    # sentinel
            break

        seq, data, enqueue_time = item
        age = time.time() - enqueue_time

        # ── Stale frame discard ───────────────────────────────────
        if age > MAX_FRAME_AGE_S:
            dropped_stale += 1
            print(f"[TCP][DROP-STALE] seq={seq}  age={age*1000:.1f}ms > {MAX_FRAME_AGE_S*1000:.0f}ms")
            send_queue.task_done()
            continue

        send_time = time.time()
        header    = struct.pack("IdI", seq, send_time, len(data))
        packet    = header + data

        # ── Non-blocking socket send ──────────────────────────────
        try:
            sock.setblocking(True)   # send itself must be blocking to avoid partial writes
            sock.sendall(packet)
            frames_actually_sent += 1
            with send_times_lock:
                send_times[seq] = (send_time, len(data))
        except BlockingIOError:
            # TCP send buffer full — drop this frame
            dropped_socket_block += 1
            print(f"[TCP][DROP-BLOCK] seq={seq}  TCP buffer full")
        except Exception as e:
            print(f"[TCP][SEND-ERROR] seq={seq}: {e}")
        finally:
            sock.setblocking(False)

        send_queue.task_done()


# ─────────────────────────────────────────────────────────────────────
#  MAIN SENDER LOOP — captures frames and puts into queue
# ─────────────────────────────────────────────────────────────────────
threading.Thread(target=receiver_thread, daemon=True).start()
sender_thread = threading.Thread(target=sender_worker, daemon=False)
sender_thread.start()

for seq in range(MAX_FRAMES):
    loop_start = time.time()

    img = make_frame(seq)
    if img is None:
        time.sleep(1 / SEND_FPS)
        continue

    _, jpg = cv2.imencode('.jpg', img,
                          [int(cv2.IMWRITE_JPEG_QUALITY), JPEG_QUALITY])
    data = jpg.tobytes()
    capture_time = time.time()

    # ── Queue full → application-layer drop ──────────────────────
    try:
        send_queue.put_nowait((seq, data, capture_time))
    except queue.Full:
        dropped_queue_full += 1
        print(f"[TCP][DROP-QUEUE] seq={seq}  queue full ({QUEUE_MAXSIZE} max)")

    elapsed   = time.time() - loop_start
    time.sleep(max(0.0, (1.0 / SEND_FPS) - elapsed))

# Signal sender worker to stop
send_queue.put(None)
sender_thread.join()

print(f"[DONE] Attempted {MAX_FRAMES} frames. Waiting for feedback...")
recv_done_event.wait(timeout=30)

save_csv()

if not USE_SYNTHETIC:
    cap.release()
sock.close()
